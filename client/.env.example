# Base URL of the NestJS API (backend/), including the /api/v1 prefix.
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"

# Optional hero video on the landing page. A file URL or a YouTube link — watch,
# youtu.be, /embed/ and /shorts/ all work, and a YouTube link is embedded through
# youtube-nocookie.com only after the visitor presses play.
# Leave unset and the page shows the pitch illustration instead.
NEXT_PUBLIC_HERO_VIDEO_URL=""
# Poster frame for a file URL. Ignored for YouTube links, which bring their own.
NEXT_PUBLIC_HERO_POSTER_URL=""

# Public origin of this deployment, used for canonical URLs, the sitemap and
# social cards. Absolute URLs are required there; a relative canonical is ignored
# and a relative social image is never fetched.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google sign-in — the same OAuth client id the backend verifies against
# (GOOGLE_CLIENT_ID). Public by design: it identifies the app, and the token it
# yields is only trusted after the backend checks Google's signature on it.
# The button does not render while this is empty.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Telegram sign-in — the bot's username, without the @. The bot *token* stays on
# the backend; this only tells the widget which bot to sign in through.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""
