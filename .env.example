# Root .env — read by docker-compose.yml ONLY.
#
# Compose reads `.env` from the directory containing docker-compose.yml, which is
# this one. It does NOT read backend/.env, so these variables have to live here.
#
# You only need this file to CHANGE something: docker-compose.yml already defaults
# to the values below, so `docker compose up -d` works without it.
#
# If you do change a value, change the matching half in backend/.env:
#   POSTGRES_* / POSTGRES_PORT  ->  DATABASE_URL
#   REDIS_PORT                  ->  REDIS_URL

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fotspot

# Change these if a local Postgres/Redis already owns the default port.
POSTGRES_PORT=5432
REDIS_PORT=6379
