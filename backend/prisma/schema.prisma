// FotSpot - MVP schema
// Scope: section 1.23 MVP only. Post-acceptance lifecycle / pro transition / badges
// (README sections 3-8) are Phase 1.5+/2 and intentionally NOT modeled here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- RBAC (1.4) ----------

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // scout, player, coach, academy_manager, admin, super_admin
  description String?
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime @default(now())
}

model Permission {
  id        String   @id @default(uuid())
  key       String   @unique // e.g. "coach:verify", "admin:manage_roles"
  description String?
  roles     RolePermission[]
  createdAt DateTime @default(now())
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ---------- USERS / AUTH (1.3) ----------

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id            String   @id @default(uuid())
  phone         String?  @unique
  email         String?  @unique
  /// Only set for accounts an admin created on someone else's behalf (academy
  /// managers, §1.10). Self-registered users sign in with email or phone and
  /// never get one, hence nullable rather than a required unique handle.
  username      String?  @unique
  passwordHash  String?
  firstName     String?
  lastName      String?
  /// R2 object key, never a URL — see src/storage/storage.keys.ts.
  ///
  /// A stored URL outlives every decision that produced it: change the CDN, the
  /// domain or the provider and every row is wrong, with a migration as the only
  /// fix. The public URL is built at read time instead. Avatars are the one
  /// public tier (`public/avatars/…`); everything else is private.
  avatarKey     String?
  isActive      Boolean  @default(true)
  /// True while the account still has its admin-generated password. The admin who
  /// created it knows that password, so it must not stay valid indefinitely on an
  /// account with access to children's profiles.
  mustChangePassword Boolean @default(false)

  roles         UserRole[]
  sessions      Session[]
  playerProfile PlayerProfile?
  coachProfile  CoachProfile?
  academyMemberships AcademyMember[]
  recommendationsMade Recommendation[] @relation("ScoutRecommendations")
  coachAssessmentsMade CoachAssessment[] @relation("CoachAssessments")
  notifications Notification[]
  otpCodes      OtpCode[]
  verificationCodes VerificationCode[]
  auditLogs     AuditLog[]
  reportsFiled  Report[] @relation("ReportsFiled")
  follows       Follow[] @relation("UserFollows")
  followedByAcademies AcademyScoutFollow[] @relation("AcademyScoutFollows")
  academyEndorsements AcademyEndorsement[] @relation("AcademyEndorsements")
  mediaComments MediaComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * One row per logged-in device - README 1.21 (Refresh Tokens + Device Tracking).
 * Replaces the single User.refreshTokenHash, which allowed exactly one session per
 * user: logging in on a phone silently killed the tablet. The refresh token carries
 * this row's id as its `sid` claim, so rotation and revocation target one device.
 */
model Session {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String
  deviceId         String?
  userAgent        String?
  ipAddress        String?

  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model OtpCode {
  id        String   @id @default(uuid())
  userId    String?
  phone     String
  codeHash  String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

enum VerificationChannel {
  PHONE
  EMAIL
}

/**
 * Confirms ownership of a NEW phone number or email before it replaces the one on
 * the account.
 *
 * Separate from OtpCode, which authenticates a *login* against a phone that may not
 * belong to any user yet. This proves an already-authenticated user controls a
 * destination they are moving to — different lifecycle, different owner, and
 * reusing OtpCode would have meant stuffing an email address into a `phone` column.
 */
model VerificationCode {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  channel     VerificationChannel
  destination String
  codeHash    String
  expiresAt   DateTime
  consumed    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, channel])
}

// ---------- PLAYER PROFILE (1.6) ----------

enum DominantFoot {
  LEFT
  RIGHT
  BOTH
}

/**
 * Playing style - README 21.3. Recruitment metadata, not decoration: academies
 * recruit for a *role* ("we need a Destroyer, U16, Fergana"), which position alone
 * cannot express. Grouped by position in the spec; stored flat here.
 */
enum PlayingStyle {
  // Forward
  POACHER
  TARGET_MAN
  DEEP_LYING_FORWARD
  WIDE_THREAT
  // Midfield
  BOX_TO_BOX
  PLAYMAKER
  DESTROYER
  ORCHESTRATOR
  // Defence
  BALL_PLAYING_DEFENDER
  STOPPER
  OVERLAPPING_FULL_BACK
  SWEEPER
  // Goalkeeper
  OFFENSIVE_KEEPER
  DEFENSIVE_KEEPER
}

model PlayerProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName   String
  lastName    String
  birthDate   DateTime
  gender      String

  height      Float?
  weight      Float?

  dominantFoot     DominantFoot?
  primaryPosition  String?
  secondaryPosition String?
  playingStyle     PlayingStyle?

  region      String?
  district    String?

  matches      Int @default(0)
  goals        Int @default(0)
  assists      Int @default(0)
  cleanSheets  Int @default(0)
  sprintTime   Float?
  jugglingRecord Int?

  media           Media[]
  recommendations Recommendation[]
  recommendationWeight PlayerRecommendationWeight?
  academyWeights  PlayerAcademyRecommendationWeight[]
  coachAssessments CoachAssessment[]
  trialApplications TrialApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- COACH PROFILE (1.2 / 1.9) ----------

model CoachProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio    String?
  status VerificationStatus @default(PENDING)

  academyMemberships AcademyMember[]
  assessments        CoachAssessment[] @relation("CoachProfileAssessments")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- ACADEMY (1.10) ----------

model AcademyProfile {
  id       String @id @default(uuid())
  name     String
  region   String?
  district String?
  description String?
  status   VerificationStatus @default(PENDING)

  members  AcademyMember[]
  trials   Trial[]
  recommendations Recommendation[]
  scoutFollows AcademyScoutFollow[]
  endorsements AcademyEndorsement[]
  recommendationTargets RecommendationTarget[]
  playerWeights PlayerAcademyRecommendationWeight[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AcademyMemberRole {
  MANAGER
  COACH
  SCOUT
}

model AcademyMember {
  id         String @id @default(uuid())
  academyId  String
  userId     String
  coachId    String?
  role       AcademyMemberRole

  academy    AcademyProfile @relation(fields: [academyId], references: [id], onDelete: Cascade)
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  coach      CoachProfile? @relation(fields: [coachId], references: [id])

  createdAt DateTime @default(now())

  @@unique([academyId, userId])
}

// ---------- MEDIA (1.7) ----------

enum MediaType {
  IMAGE
  VIDEO
}

/// One value per player-card attribute (§21.1), plus highlights.
///
/// Renamed from SPRINT/SHOOTING so a clip's category *is* the bar it evidences.
/// When the two vocabularies differed, nothing could connect a video to the
/// attribute it was uploaded to prove.
enum MediaCategory {
  PACE
  DRIBBLING
  PASSING
  FINISHING
  PHYSICAL
  TECHNIQUE
  MATCH_HIGHLIGHTS
}

enum MediaStatus {
  ACTIVE
  FLAGGED
  REMOVED
}

model Media {
  id         String @id @default(uuid())
  playerId   String
  player     PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  type       MediaType
  category   MediaCategory

  /// R2 object key under `private/players/<playerId>/`. There is deliberately no
  /// `url` column: a clip of a child must never have a permanent public address,
  /// and a column holding one is an address nobody can revoke. Playback goes
  /// through `GET /media/:id/url`, which authorizes first and then signs a URL
  /// that expires in minutes.
  storageKey String
  status     MediaStatus @default(ACTIVE)

  title       String?
  description String?

  /// The player's own 0–100 claim for `category`, evidenced by this clip.
  ///
  /// Null for MATCH_HIGHLIGHTS, which evidences no single attribute. The newest
  /// ACTIVE clip per category is the player's current claim; older rows are kept
  /// so the bar has a history rather than just a value. Still self-reported —
  /// attaching a video does not make it verified (§1.6), and the card renders it
  /// as self-reported until a coach signs it off.
  selfRating  Int?

  likes      MediaLike[]
  views      MediaView[]
  comments   MediaComment[]
  reports    Report[] @relation("ReportedMedia")

  createdAt DateTime @default(now())

  @@index([playerId, category, createdAt(sort: Desc)])
}

model MediaLike {
  id      String @id @default(uuid())
  mediaId String
  userId  String
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([mediaId, userId])
}

/**
 * View counter rows (1.14 `media_views`). `userId` is null for guests, who may view
 * public media (1.2). Deliberately NOT unique per (media, user): a view is an event,
 * not a state, unlike a like.
 */
model MediaView {
  id      String @id @default(uuid())
  mediaId String
  userId  String?
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([mediaId])
}

model MediaComment {
  id      String @id @default(uuid())
  mediaId String
  userId  String
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  body    String
  status  MediaStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mediaId])
}

// ---------- FOLLOWS (1.2 / 1.5.2) ----------

enum FollowTargetType {
  PLAYER
  ACADEMY
}

/** Scout -> player / academy following (1.2 Scout permissions). */
model Follow {
  id         String @id @default(uuid())
  followerId String
  follower   User   @relation("UserFollows", fields: [followerId], references: [id], onDelete: Cascade)

  targetType FollowTargetType
  targetId   String

  createdAt DateTime @default(now())

  @@unique([followerId, targetType, targetId])
  @@index([targetType, targetId])
}

enum AcademyScoutFollowState {
  FOLLOWING
  MUTED
}

/** Who an academy can take on: a scout, or a coach. */
enum EndorsementRole {
  SCOUT
  COACH
}

enum EndorsementStatus {
  ACTIVE
  REVOKED
}

/**
 * An academy has endorsed (hired / accredited) a scout or coach - README 1.5.3.
 *
 * This is the ONLY academy→person relationship with functional consequences, and
 * the distinction from `AcademyScoutFollow` is the point: following is social and
 * changes nothing, the way following someone on Instagram doesn't give them a job.
 * Endorsement does two things:
 *
 *   1. It is the gate for SPECIFIC recommendations — a scout may only address a
 *      recommendation to an academy that has endorsed them.
 *   2. It is what earns a specific recommendation its extra weight for that
 *      academy, because the academy has already staked its own judgement on the
 *      person making it.
 *
 * Revoked rather than deleted: an academy that drops a scout should not silently
 * rewrite the history of recommendations that scout already made for them.
 */
model AcademyEndorsement {
  id        String @id @default(uuid())
  academyId String
  userId    String
  role      EndorsementRole
  status    EndorsementStatus @default(ACTIVE)

  academy   AcademyProfile @relation(fields: [academyId], references: [id], onDelete: Cascade)
  user      User           @relation("AcademyEndorsements", fields: [userId], references: [id], onDelete: Cascade)

  note      String?
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  updatedAt DateTime  @updatedAt

  @@unique([academyId, userId, role])
  @@index([userId, status])
}

/**
 * A player's discoverability weight, accumulated from every recommendation.
 *
 * Stored rather than computed on read for one specific reason: a scheduled job
 * will decay it, so that a player recommended two years ago doesn't outrank a
 * 13-year-old recommended last week purely by accumulation. A derived-on-read sum
 * has nowhere to put that decay. `lastDecayedAt` is the cron's bookmark.
 */
model PlayerRecommendationWeight {
  playerId            String   @id
  player              PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  globalWeight        Float    @default(0)
  recommendationCount Int      @default(0)
  lastRecommendedAt   DateTime?
  lastDecayedAt       DateTime?
  updatedAt           DateTime @updatedAt

  @@index([globalWeight])
}

/**
 * The extra weight one academy sees for one player, from SPECIFIC recommendations
 * addressed to them. Never leaves that academy: it is their own scouts' opinion of
 * a player, not a public score (README 21.5 — no public ranking of minors).
 */
model PlayerAcademyRecommendationWeight {
  playerId            String
  academyId           String
  player              PlayerProfile  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  academy             AcademyProfile @relation(fields: [academyId], references: [id], onDelete: Cascade)

  extraWeight         Float    @default(0)
  recommendationCount Int      @default(0)
  updatedAt           DateTime @updatedAt

  @@id([playerId, academyId])
  @@index([academyId, extraWeight])
}

/**
 * Academy -> scout trust (README 1.5.2). Separate from `Follow` because the
 * follower is an *academy*, not a user, and because MUTED has no meaning in the
 * scout->player direction. Affects that academy's own recommendation ranking only -
 * never the scout's global reputation (1.5).
 */
model AcademyScoutFollow {
  id        String @id @default(uuid())
  academyId String
  scoutId   String

  academy   AcademyProfile @relation(fields: [academyId], references: [id], onDelete: Cascade)
  scout     User           @relation("AcademyScoutFollows", fields: [scoutId], references: [id], onDelete: Cascade)

  state     AcademyScoutFollowState @default(FOLLOWING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([academyId, scoutId])
  @@index([scoutId])
}

// ---------- SCOUT REPUTATION (1.5) ----------

model ScoutStats {
  id                     String @id @default(uuid())
  userId                 String @unique
  totalRecommendations   Int    @default(0)
  acceptedRecommendations Int   @default(0)
  successRate            Float  @default(0)
  level                  Int    @default(1) // 1..6, see RecommendationsService.computeScoutLevel
  weight                 Int    @default(1)
  updatedAt              DateTime @updatedAt
}

// ---------- RECOMMENDATIONS (1.8) ----------

enum RecommendationStatus {
  PENDING
  REVIEWING
  ACCEPTED
  REJECTED
}

/**
 * GLOBAL  - "this player is worth looking at", addressed to nobody. Any scout may
 *           file one. It raises the player's discoverability weight and has no
 *           accept/reject lifecycle, so it never counts toward success_rate.
 * SPECIFIC- addressed to one or more academies that have ENDORSED this scout
 *           (README 1.5.3). Each target academy decides independently, and those
 *           decisions are what move the scout's reputation.
 */
enum RecommendationType {
  GLOBAL
  SPECIFIC
}

model Recommendation {
  id         String @id @default(uuid())
  scoutId    String
  playerId   String
  type       RecommendationType @default(SPECIFIC)

  /**
   * Legacy single-academy column, kept for rows created before targets existed and
   * for the common one-academy case. GLOBAL recommendations leave it null; the
   * authoritative target list is `targets`.
   */
  academyId  String?
  status     RecommendationStatus @default(PENDING)
  note       String?

  /**
   * The scout's §1.5 weight at the moment of filing, not a live lookup.
   * A recommendation is evidence about a point in time: if the scout later climbs
   * to Legendary, that shouldn't retroactively reweight everything they ever said,
   * and the future decay cron needs a stable number to decay.
   */
  scoutWeight Int @default(1)

  scout      User @relation("ScoutRecommendations", fields: [scoutId], references: [id])
  player     PlayerProfile @relation(fields: [playerId], references: [id])
  academy    AcademyProfile? @relation(fields: [academyId], references: [id])
  targets    RecommendationTarget[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([playerId])
  @@index([scoutId])
}

/**
 * One target academy of a SPECIFIC recommendation, with its own decision.
 *
 * Separate status per academy because two academies can legitimately disagree
 * about the same player, and the scout's success rate has to reflect each verdict
 * rather than collapsing them into one.
 */
model RecommendationTarget {
  recommendationId String
  academyId        String
  status           RecommendationStatus @default(PENDING)

  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  academy          AcademyProfile @relation(fields: [academyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([recommendationId, academyId])
  @@index([academyId, status])
}

// ---------- COACH ASSESSMENT (1.9) ----------

model CoachAssessment {
  id       String @id @default(uuid())
  coachUserId String
  coachProfileId String
  playerId String

  coachUser  User @relation("CoachAssessments", fields: [coachUserId], references: [id])
  coachProfile CoachProfile @relation("CoachProfileAssessments", fields: [coachProfileId], references: [id])
  player     PlayerProfile @relation(fields: [playerId], references: [id])

  speed      Int
  passing    Int
  vision     Int
  dribbling  Int
  finishing  Int
  physical   Int
  leadership Int
  discipline Int

  notes      String?
  mediaUrls  String[]
  documentUrls String[]

  createdAt DateTime @default(now())
}

// ---------- TRIALS (1.11) ----------

model Trial {
  id         String @id @default(uuid())
  academyId  String
  academy    AcademyProfile @relation(fields: [academyId], references: [id], onDelete: Cascade)

  title       String
  ageRangeMin Int
  ageRangeMax Int
  positions   String[]
  location    String
  date        DateTime
  requirements String?

  applications TrialApplication[]

  createdAt DateTime @default(now())
}

enum TrialApplicationStatus {
  APPLIED
  SHORTLISTED
  INVITED
  REJECTED
  ACCEPTED
}

model TrialApplication {
  id       String @id @default(uuid())
  trialId  String
  playerId String
  status   TrialApplicationStatus @default(APPLIED)

  trial    Trial @relation(fields: [trialId], references: [id], onDelete: Cascade)
  player   PlayerProfile @relation(fields: [playerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([trialId, playerId])
}

// ---------- NOTIFICATIONS (1.12) ----------

enum NotificationEvent {
  RECOMMENDATION_ACCEPTED
  RECOMMENDATION_REJECTED
  TRIAL_INVITATION
  TRIAL_RESULT
  VERIFICATION_RESULT
}

model Notification {
  id      String @id @default(uuid())
  userId  String
  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)

  event   NotificationEvent
  payload Json
  read    Boolean @default(false)

  createdAt DateTime @default(now())
}

// ---------- MODERATION (1.13) ----------

enum ReportType {
  USER
  MEDIA
  ACADEMY
  COACH
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

model Report {
  id       String @id @default(uuid())
  type     ReportType
  reason   String

  reporterId String
  reporter   User @relation("ReportsFiled", fields: [reporterId], references: [id])

  targetUserId    String?
  targetMediaId   String?
  targetAcademyId String?
  targetCoachId   String?
  targetMedia     Media? @relation("ReportedMedia", fields: [targetMediaId], references: [id])

  status   ReportStatus @default(PENDING)
  resolutionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- AUDIT (1.21) ----------

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  meta      Json?
  createdAt DateTime @default(now())
}
