// FotSpot - MVP schema
// Scope: section 1.23 MVP only. Post-acceptance lifecycle / pro transition / badges
// (README sections 3-8) are Phase 1.5+/2 and intentionally NOT modeled here.

generator client {
  provider = "prisma-client-js"
}

// `url` is what the running API queries through; `directUrl` is what migrations
// use. On a managed Postgres they are two different endpoints and the split
// matters: Neon's `-pooler` host is PgBouncer in transaction mode, which is right
// for many short-lived app queries and wrong for `migrate deploy`, whose advisory
// lock has to outlive a single transaction to stop two deploys migrating at once.
//
// Both point at the same database, so a single-server Postgres sets them to the
// same value — see .env.example. `directUrl` is read only by the Prisma CLI, so
// it costs the running app nothing.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- RBAC (1.4) ----------

model Role {
  id          String           @id @default(uuid())
  name        String           @unique // scout, player, coach, academy_manager, admin, super_admin
  description String?
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique // e.g. "coach:verify", "admin:manage_roles"
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ---------- TARIFF PLANS ----------

enum PlanTier {
  FREE
  PRO
  PREMIUM
}

/**
 * What one tier of account is allowed to do, in numbers a super admin can edit.
 * Exactly three rows, seeded and never created or deleted through the API: the
 * tier *is* the identity, so `tier` is the primary key rather than a uuid with a
 * unique constraint beside it. A fourth tier is a schema change and a product
 * decision, not a row somebody adds on a Tuesday.
 * The limits live here rather than in environment variables because they are
 * product levers, not deployment configuration — the person who decides that Pro
 * gets thirty clips a week is not the person with shell access, and a redeploy
 * is the wrong unit of change for a number that sells the plan.
 * Every limit is a plain count with no "unlimited" sentinel. A very large number
 * says the same thing and needs no branch at every call site that reads one;
 * inventing `0 = unlimited` would make the most permissive plan look like the
 * most restrictive one on the screen that edits it.
 */
model TariffPlan {
  tier PlanTier @id

  /// A — clips a player may upload per window.
  clipLimit                  Int @default(10)
  /// B — the length of that window, in days. Rolling, not calendar: a limit that
  /// resets at midnight on the 1st is a limit everybody hits on the 2nd.
  clipWindowDays             Int @default(7)
  /// C — how many of a scout's recommendations may be awaiting a verdict at once.
  ///
  /// A cap on *undecided* work, not on lifetime output: a scout whose picks keep
  /// being answered can keep filing forever, and one who files fifty and waits is
  /// asked to let the first ones land first. This is what makes the number a
  /// quality lever rather than a quota.
  pendingRecommendationLimit Int @default(10)
  /// D — coaches an academy manager may create.
  maxCoaches                 Int @default(5)
  /// E — squad groups an academy manager may create.
  maxGroups                  Int @default(5)

  users User[]

  updatedAt DateTime @default(now()) @updatedAt
}

// ---------- USERS / AUTH (1.3) ----------

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id    String  @id @default(uuid())
  phone String? @unique
  email String? @unique

  /// The Telegram account that may sign in as this user, if one has been linked.
  ///
  /// Telegram's Login Widget identifies a person by their Telegram id and does
  /// **not** disclose a phone number — that is only obtainable by asking inside a
  /// chat, which a login button is not. So the id is what a returning Telegram
  /// user is recognised by; matching on `phone` would mean matching on something
  /// Telegram never sends.
  ///
  /// Unique because it is a credential: two accounts carrying the same Telegram
  /// id would make "sign in with Telegram" ambiguous, and an ambiguity in an
  /// authentication lookup resolves to whichever row came back first.
  telegramId String? @unique

  /// Whether this account wants FotSpot notifications delivered to Telegram.
  ///
  /// A *preference*, and the only thing the Disconnect button on /profile/edit
  /// writes. `telegramId` is deliberately never cleared: it is the identity
  /// `AuthService.telegramLogin` recognises a returning user by, so an id that
  /// stopped being stored would stop being recognised and the next Telegram
  /// sign-in would mint a **new account** — an unlimited supply of them, one per
  /// disconnect. Turning messages off must not be a way to manufacture accounts.
  ///
  /// Default false, and set true when an account links Telegram or presses
  /// /start in the bot. It is not a promise the bot can actually reach them:
  /// Telegram refuses `sendMessage` to anybody who has never opened a chat with
  /// the bot, and only /start fixes that. A refused delivery is logged and
  /// dropped rather than switching this off, because overriding a preference the
  /// person just set would leave them toggling it on and off with no explanation.
  ///
  /// There is no separate `telegramChatId`: in a private chat the chat id *is*
  /// the user id, so a second column would hold a copy of `telegramId` and could
  /// only ever disagree with it.
  telegramNotificationsEnabled Boolean @default(false)

  /// Support requests this account raised, and the ones it handled as an admin.
  supportRequests        SupportRequest[] @relation("RequestsMade")
  handledSupportRequests SupportRequest[] @relation("RequestsHandled")
  /// Public handle, `colour-animal-football-number` by default (see
  /// username.util.ts). Every account gets one — it is how `/players/@handle`
  /// resolves and how someone signs in without remembering which email they used.
  ///
  /// Still nullable because accounts created before handles existed have none
  /// until `UsersService.findMe` backfills them on first read.
  username               String?          @unique

  /// When the address was proved, not merely typed. Null for accounts created
  /// before registration required a code, and for phone/OAuth signups that have
  /// no email at all.
  /// When true, the account is hidden from public listings and its profile is
  /// only readable by the account itself and by admins. Set from Settings.
  ///
  /// Default false rather than true: an account nobody can find cannot be
  /// scouted, and being seen is what the platform is for. The switch exists
  /// because a fourteen-year-old's guardian may reasonably want it off.
  isPrivate Boolean @default(false)

  emailVerifiedAt    DateTime?
  passwordHash       String?
  firstName          String?
  lastName           String?
  /// R2 object key, never a URL — see src/storage/storage.keys.ts.
  ///
  /// A stored URL outlives every decision that produced it: change the CDN, the
  /// domain or the provider and every row is wrong, with a migration as the only
  /// fix. The public URL is built at read time instead. Avatars are the one
  /// public tier (`public/avatars/…`); everything else is private.
  avatarKey          String?
  isActive           Boolean   @default(true)
  /// True while the account still has its admin-generated password. The admin who
  /// created it knows that password, so it must not stay valid indefinitely on an
  /// account with access to children's profiles.
  mustChangePassword Boolean   @default(false)

  /**
   * When this account last opened the trials list.
   * The badge on the Trials menu counts what has appeared since. A timestamp
   * rather than a join table of seen trial ids: the question is "anything new?",
   * which a single comparison answers, and a row per user per trial would grow
   * without bound to store something nobody ever reads individually.
   * Null means never opened, so everything currently open counts as new — which
   * is the right welcome for somebody who has not looked yet.
   */
  trialsSeenAt DateTime?

  /// Which tariff this account is on. One per account, not one per role: a
  /// person who scouts and also has a player card is one customer, and two
  /// plans on one account would mean two answers to "what may I do today".
  ///
  /// Only a super admin moves it (§1.2) — there is no self-serve upgrade, so a
  /// column rather than a subscription table is the honest shape: there is no
  /// billing period, no payment and no history to keep yet.
  planTier PlanTier   @default(FREE)
  plan     TariffPlan @relation(fields: [planTier], references: [tier])

  roles                  UserRole[]
  sessions               Session[]
  playerProfile          PlayerProfile?
  coachProfile           CoachProfile?
  academyMemberships     AcademyMember[]
  academyInvitations     AcademyInvitation[]    @relation("InvitationsReceived")
  recommendationsMade    Recommendation[]       @relation("ScoutRecommendations")
  coachAssessmentsMade   CoachAssessment[]      @relation("CoachAssessments")
  notifications          Notification[]
  notificationsTriggered Notification[]         @relation("NotificationActors")
  otpCodes               OtpCode[]
  verificationCodes      VerificationCode[]
  passwordResetCodes     PasswordResetCode[]
  auditLogs              AuditLog[]
  reportsFiled           Report[]               @relation("ReportsFiled")
  follows                Follow[]               @relation("UserFollows")
  followedByAcademies    AcademyScoutFollow[]   @relation("AcademyScoutFollows")
  academyEndorsements    AcademyEndorsement[]   @relation("AcademyEndorsements")
  coachReviews           RecommendationReview[] @relation("CoachReviews")
  reviewAssignments      ReviewCoach[]          @relation("ReviewAssignments")
  trialCoaching          TrialCoach[]           @relation("TrialCoaching")
  trialVerdicts          TrialResult[]          @relation("TrialVerdicts")
  mediaComments          MediaComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * One row per logged-in device - README 1.21 (Refresh Tokens + Device Tracking).
 * Replaces the single User.refreshTokenHash, which allowed exactly one session per
 * user: logging in on a phone silently killed the tablet. The refresh token carries
 * this row's id as its `sid` claim, so rotation and revocation target one device.
 */
model Session {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String
  deviceId         String?
  userAgent        String?
  ipAddress        String?

  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model OtpCode {
  id        String   @id @default(uuid())
  userId    String?
  phone     String
  codeHash  String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

enum VerificationChannel {
  PHONE
  EMAIL
}

/**
 * Confirms ownership of a NEW phone number or email before it replaces the one on
 * the account.
 * Separate from OtpCode, which authenticates a *login* against a phone that may not
 * belong to any user yet. This proves an already-authenticated user controls a
 * destination they are moving to — different lifecycle, different owner, and
 * reusing OtpCode would have meant stuffing an email address into a `phone` column.
 */
model VerificationCode {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  channel     VerificationChannel
  destination String
  codeHash    String
  expiresAt   DateTime
  consumed    Boolean             @default(false)
  createdAt   DateTime            @default(now())

  @@index([userId, channel])
}

/**
 * A code proving someone controls an email address **before** an account exists
 * for it.
 * Separate from VerificationCode, which requires a `userId` because it confirms a
 * change to an account that is already there. At registration there is no user to
 * point at, and widening that relation to nullable would erase the invariant that
 * makes it readable. Separate from OtpCode too, which authenticates a login by
 * phone and would mean storing an email in a column called `phone`.
 */
model RegistrationCode {
  id        String   @id @default(uuid())
  email     String
  codeHash  String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, consumed])
}

/**
 * A code that lets someone set a new password without knowing the old one.
 * Its own table rather than another `VerificationCode` row: that model confirms a
 * *new* destination the user is moving to, while this authorises a credential
 * change on an address they already hold. Same shape, opposite meaning — and the
 * two have different lifecycles, since resetting also revokes every session.
 */
model PasswordResetCode {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  codeHash  String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, consumed])
}

// ---------- PLAYER PROFILE (1.6) ----------

enum DominantFoot {
  LEFT
  RIGHT
  BOTH
}

/**
 * Playing style - README 21.3. Recruitment metadata, not decoration: academies
 * recruit for a *role* ("we need a Destroyer, U16, Fergana"), which position alone
 * cannot express. Grouped by position in the spec; stored flat here.
 */
enum PlayingStyle {
  // Forward
  GOAL_POACHER
  FOX_IN_THE_BOX
  DEEP_LYING_FORWARD
  PROLIFIC_WINGER
  CLASSIC_10
  // Midfield
  BOX_TO_BOX
  PLAYMAKER
  ANCHOR_MAN
  ORCHESTRATOR
  // Defence
  BUILD_UP
  DEFENSIVE_FULLBACK
  OFFENSIVE_WINGBACK
  DESTROYER
  // Goalkeeper
  OFFENSIVE_KEEPER
  DEFENSIVE_KEEPER
}

model PlayerProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String
  birthDate DateTime
  gender    String

  height Float?
  weight Float?

  dominantFoot      DominantFoot?
  primaryPosition   String?
  secondaryPosition String?
  playingStyle      PlayingStyle?

  region   String?
  district String?

  matches        Int    @default(0)
  goals          Int    @default(0)
  assists        Int    @default(0)
  cleanSheets    Int    @default(0)
  sprintTime     Float?
  jugglingRecord Int?

  media                Media[]
  recommendations      Recommendation[]
  recommendationWeight PlayerRecommendationWeight?
  academyWeights       PlayerAcademyRecommendationWeight[]
  coachAssessments     CoachAssessment[]
  trialApplications    TrialApplication[]
  reviews              RecommendationReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- COACH PROFILE (1.2 / 1.9) ----------

model CoachProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio    String?
  status VerificationStatus @default(PENDING)

  academyMemberships AcademyMember[]
  assessments        CoachAssessment[] @relation("CoachProfileAssessments")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- ACADEMY (1.10) ----------

/**
 * Whether this row is a real academy or a local team.
 * ## Why not another `VerificationStatus` value
 * `status` answers "has an admin checked this", and `VerificationStatus` is
 * shared with `CoachProfile` — adding `UNVERIFIED` there would put a value on
 * every coach that means nothing about coaches. Worse, `PENDING` and `REJECTED`
 * already mean "waiting to be reviewed" and "archived", and a local team is
 * neither: it is not queued for promotion into an academy, and it is not dead.
 * So this is a second, independent axis. A row has a kind *and* a status, and
 * every existing academy is `ACADEMY` by default — the migration changes no
 * row's behaviour, which is the whole point.
 * ## What the kind decides
 * The professional evaluation pipeline: coaches, online coach review, trials,
 * pass/fail, and the recommendation settlement that hangs off them. A local team
 * has none of it. What it shares is the squad — invitations, membership, groups,
 * scouts — because that half is the same job at both.
 */
enum AcademyKind {
  ACADEMY
  LOCAL_TEAM
}

model AcademyProfile {
  id               String             @id @default(uuid())
  name             String
  /// Academy or local team. See AcademyKind — this gates the coach/trial half.
  kind             AcademyKind        @default(ACADEMY)
  region           String?
  district         String?
  description      String?
  /**
   * What this academy writes on every trial unless it says otherwise.
   * Sanitised HTML, same as `Trial.note`. It exists because the note is largely
   * the same each time — the same pitch, the same kit, the same person to ask
   * for — and retyping it per trial is how it ends up half-written or missing.
   * Copied into the trial at creation rather than joined at read time: a trial
   * that has happened should keep the words the family actually read, not
   * whatever the academy's default says a year later.
   */
  defaultTrialNote String?
  status           VerificationStatus @default(PENDING)

  /**
   * Where the academy actually is, as coordinates.
   * `region`/`district` above are the search filters — the buckets an academy is
   * listed under. These two are the place a parent has to drive their child to
   * on a Saturday morning, which a district name does not answer.
   * Nullable together and always written together: half a coordinate points at
   * the Gulf of Guinea. Stored as Float rather than Decimal because six decimal
   * places is roughly a tenth of a metre and nothing here needs better.
   */
  latitude  Float?
  longitude Float?

  /// Search terms an operator wants this academy found by.
  ///
  /// Never rendered as page content — see `lib/seo.ts` on the client. They feed
  /// the metadata a crawler reads, alongside the real title, description and
  /// canonical, and they supplement that content rather than replacing it.
  ///
  /// A Postgres text array rather than a join table, matching `Trial.positions`:
  /// the values are short, unordered, never queried individually and only ever
  /// read as a whole with the row they belong to.
  ///
  /// Defaulted to empty so every existing row has an answer at migration time
  /// rather than a null every reader would have to interpret. Normalised on the
  /// way in — trimmed, de-duplicated case-insensitively, capped — by
  /// `seo-keywords.util.ts`, so the column cannot accumulate near-duplicates.
  seoKeywords String[] @default([])

  /// Public handle, resolving `/academies/@handle`. Chosen by the manager.
  ///
  /// Stored without the `@` and lowercased — the sigil is what the URL and the
  /// UI wear, never part of the value, so a unique index cannot be fooled by
  /// `@Bunyodkor_Academy` versus `bunyodkor_academy`.
  ///
  /// Unique because it is an identity: two academies answering to one handle
  /// would make `/academies/@x` ambiguous, and an ambiguity in a lookup resolves
  /// to whichever row came back first. Nullable because an academy that has not
  /// chosen one is still an academy — it is reached by id until it does.
  ///
  /// The shape (`name_academy`, underscores only) lives in
  /// `academy-username.util.ts`, which also explains why it uses underscores
  /// where player handles use hyphens: the two share the `@` sigil, and
  /// disjoint shapes make a collision impossible without a cross-table check.
  username String? @unique

  /// R2 object key for the academy's logo, never a URL — see storage.keys.ts.
  logoKey String?

  /**
   * Where to find the academy off the platform.
   * Four fields rather than a Json blob: the set is fixed (§ the product allows
   * Telegram, Facebook, Instagram and YouTube and nothing else), and four
   * nullable columns are four things a query can filter on and a validator can
   * check the host of. A blob would accept `{"myspace": "..."}` for ever.
   * Full URLs, host-validated on write — a bare handle is ambiguous across
   * platforms and unlinkable without guessing the prefix.
   */
  telegramUrl  String?
  facebookUrl  String?
  instagramUrl String?
  youtubeUrl   String?

  /**
   * How to phone the academy, and where to try when the first one rings out.
   * Two columns rather than one, because these are two different numbers with
   * two different jobs: the primary is the one printed on the profile, and the
   * backup is what a parent tries at eight in the evening when nobody answers
   * the office. An array would store the same thing while losing which is which.
   * Not the manager's `User.phone`. That is how the platform reaches the person
   * who signs in; this is how a family reaches the club, and a manager who
   * leaves should not take the academy's number with them.
   * E.164, validated at the edge like every other phone in the schema.
   */
  primaryPhone String?
  backupPhone  String?

  photos   AcademyPhoto[]
  featured AcademyFeatured[]

  members               AcademyMember[]
  groups                AcademyGroup[]
  transfersOut          MemberTransfer[]                    @relation("TransfersOut")
  transfersIn           MemberTransfer[]                    @relation("TransfersIn")
  invitations           AcademyInvitation[]
  trials                Trial[]
  recommendations       Recommendation[]
  scoutFollows          AcademyScoutFollow[]
  endorsements          AcademyEndorsement[]
  recommendationTargets RecommendationTarget[]
  playerWeights         PlayerAcademyRecommendationWeight[]
  reviews               RecommendationReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Every public listing filters on both halves, so they are indexed together.
  @@index([kind, status])
}

enum AcademyMemberRole {
  MANAGER
  COACH
  SCOUT
  PLAYER
}

/**
 * A membership is never deleted, only moved through these.
 * `INACTIVE` is a coach who has stopped working with the academy but whose
 * assessments still have to mean something — deleting the row would orphan every
 * judgement they ever made. `RELEASED` is the academy saying "we are done, they
 * are free to join someone else", which is what another academy imports.
 */
/**
 * A named squad inside one academy — "U14", "First team", "Goalkeepers".
 * Only the manager shapes these (§1.10): a coach works with the group they are
 * given, and letting them rename or re-cut squads would make "who is in my group"
 * a moving answer.
 * There is no `Reserve` row. Reserve is the absence of a group, so a player who
 * joins an academy is in it by construction rather than by a job that has to
 * remember to put them there — see AcademyMember.groupId.
 */
model AcademyGroup {
  id        String         @id @default(uuid())
  academyId String
  academy   AcademyProfile @relation(fields: [academyId], references: [id], onDelete: Cascade)

  name        String
  description String?
  /// R2 object key for the group photo, never a URL — see storage.keys.ts.
  imageKey    String?

  members AcademyMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Two squads called "U14" in one academy is a mistake, not a plan.
  @@unique([academyId, name])
  @@index([academyId])
}

/**
 * A photograph of the place — the pitch, the changing rooms, a squad line-up.
 * Its own table rather than a string array on the academy, because a photo has
 * an order the manager chose and a caption they wrote, and an array of keys can
 * carry neither. Reordering is what makes the first one the cover.
 */
model AcademyPhoto {
  id        String         @id @default(uuid())
  academyId String
  academy   AcademyProfile @relation(fields: [academyId], references: [id], onDelete: Cascade)

  /// R2 object key, never a URL — see storage.keys.ts.
  storageKey String
  caption    String?
  /// Position in the gallery. The lowest is the cover.
  sortOrder  Int     @default(0)

  createdAt DateTime @default(now())

  @@index([academyId, sortOrder])
}

/**
 * The people an academy chooses to show off — its top players, coaches and
 * scouts.
 * ## Picked, not computed
 * The platform could rank these itself (assessed rating, assessments written,
 * §1.5 level) and for a while that is what a derived list would do. But this is
 * the academy's shop window: the eleven-year-old they are proudest of having
 * signed is not necessarily the highest-rated one, and a wall the club cannot
 * arrange is a wall it will not use.
 * ## Rows point at a membership, not a user
 * So that leaving the academy takes somebody off the wall automatically — the
 * cascade does it, rather than a job that has to remember. Featuring a person
 * who no longer works there is the specific embarrassment this avoids.
 * The caps (ten, five, three) live in the service rather than the schema: they
 * are a product decision that may change, and `@@id` on rank already stops two
 * people holding the same slot.
 */
model AcademyFeatured {
  academyId String
  role      AcademyMemberRole
  memberId  String
  /// 1-based position within its role. Lower is more prominent.
  rank      Int

  academy AcademyProfile @relation(fields: [academyId], references: [id], onDelete: Cascade)
  member  AcademyMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([academyId, role, rank])
  /// One person cannot occupy two slots in the same list.
  @@unique([academyId, role, memberId])
  @@index([memberId])
}

/**
 * One academy offering a member to another, and the other answering.
 * Two-sided on purpose: a transfer that took effect the moment one manager
 * pressed a button would let any academy put a player on a rival's books without
 * asking. The receiving academy approves, and only then does the member move —
 * into that academy's reserve, because a new academy has not decided which squad
 * they belong in yet.
 */
model MemberTransfer {
  id       String        @id @default(uuid())
  memberId String
  member   AcademyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  fromAcademyId String
  fromAcademy   AcademyProfile @relation("TransfersOut", fields: [fromAcademyId], references: [id], onDelete: Cascade)
  toAcademyId   String
  toAcademy     AcademyProfile @relation("TransfersIn", fields: [toAcademyId], references: [id], onDelete: Cascade)

  status TransferStatus @default(PENDING)
  note   String?

  requestedByUserId String
  decidedByUserId   String?

  createdAt DateTime  @default(now())
  decidedAt DateTime?

  @@index([toAcademyId, status])
  @@index([fromAcademyId, status])
}

enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/**
 * An academy asking somebody to join it, and their answer.
 * A membership is a claim on a person's record — it decides who may assess them,
 * which squad they train with, and which club appears on their profile. So an
 * academy cannot simply write itself onto somebody: it asks, and the person
 * accepts. Only on acceptance does an AcademyMember row appear, in the reserve.
 * Separate from MemberTransfer, which is two academies agreeing about somebody
 * who has already said yes to one of them. This is the first yes.
 */
model AcademyInvitation {
  id        String         @id @default(uuid())
  academyId String
  academy   AcademyProfile @relation(fields: [academyId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation("InvitationsReceived", fields: [userId], references: [id], onDelete: Cascade)

  /// What they are being asked to join as. Never MANAGER — that is appointed.
  role   AcademyMemberRole
  status InvitationStatus  @default(PENDING)
  note   String?

  invitedByUserId String

  createdAt DateTime  @default(now())
  decidedAt DateTime?

  @@index([userId, status])
  @@index([academyId, status])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum AcademyMemberStatus {
  ACTIVE
  INACTIVE
  RELEASED
}

model AcademyMember {
  id        String              @id @default(uuid())
  academyId String
  userId    String
  coachId   String?
  role      AcademyMemberRole
  status    AcademyMemberStatus @default(ACTIVE)

  /// Set when the academy releases the member for transfer, cleared on import.
  releasedAt        DateTime?
  /// Where they came from, so a transfer is a fact on the record rather than a
  /// row that quietly changed academies overnight.
  previousAcademyId String?

  /// What kind of coach they are here — head coach, goalkeeping coach, and so on.
  ///
  /// On the membership rather than on CoachProfile because it is a job at one
  /// academy, not a property of the person: the same coach can be a head coach at
  /// one club and a youth coach at another.
  coachType String?

  /// The squad they are in, or null for the academy's reserve.
  ///
  /// Null rather than a `Reserve` group row: everybody who joins starts there, so
  /// making it the default state means no code has to remember to put them in it,
  /// and moving somebody to reserve is clearing a field rather than looking up a
  /// magic group by name.
  groupId String?
  group   AcademyGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  transfers MemberTransfer[]
  featured  AcademyFeatured[]
  joinedAt  DateTime          @default(now())

  academy AcademyProfile @relation(fields: [academyId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  coach   CoachProfile?  @relation(fields: [coachId], references: [id])

  createdAt DateTime @default(now())

  @@unique([academyId, userId])
  /// "Where does this person currently play" — asked on every profile read.
  @@index([userId, status])
}

// ---------- MEDIA (1.7) ----------

enum MediaType {
  IMAGE
  VIDEO
}

/// One value per player-card attribute (§21.1), plus highlights.
///
/// GOALKEEPING is an attribute like the rest — a keeper's clips were otherwise
/// filed under Technique and Passing, which is not what either bar claims.
///
/// Renamed from SPRINT/SHOOTING so a clip's category *is* the bar it evidences.
/// When the two vocabularies differed, nothing could connect a video to the
/// attribute it was uploaded to prove.
enum MediaCategory {
  PACE
  DRIBBLING
  PASSING
  FINISHING
  PHYSICAL
  TECHNIQUE
  GOALKEEPING
  MATCH_HIGHLIGHTS
}

/**
 * Whether a rating on a clip is the player's claim or a coach's judgement.
 */
enum RatingSource {
  SELF
  COACH
}

/**
 * What a rating was before someone changed it.
 * A coach overwriting a fourteen-year-old's own number is exactly the kind of
 * edit that has to stay answerable later — "who lowered this, and from what" is a
 * question the player's guardian may reasonably ask.
 */
model RatingRevision {
  id      String @id @default(uuid())
  mediaId String
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  /// 0–100, like every rating on the platform. Enforced by a database CHECK
  /// (`rating_revision_rating_range`) as well as the DTOs, because a revision is
  /// written by the service rather than posted by a client: nothing would have
  /// caught a bug here, and a history row holding 4200 silently poisons the chart
  /// it exists to explain.
  ///
  /// `previousRating` is null only for a clip that had no rating before.
  previousRating     Int?
  previousReportedBy RatingSource
  rating             Int
  reportedBy         RatingSource

  /// Who made the change.
  actorUserId String

  createdAt DateTime @default(now())

  @@index([mediaId, createdAt])
}

/**
 * `PROCESSING` is where every clip now starts.
 * A presigned PUT goes from the browser straight to R2, so the API never sees
 * the bytes: `confirmUpload` is the client's word that the upload happened. A
 * row written as ACTIVE on that word alone is a clip that appears on a card, in
 * search and in the feed whether or not anything was ever stored — and a
 * fourteen-year-old's evidence for a rating they claimed is exactly the thing
 * that must not be imaginary.
 * So a clip is PROCESSING until the media worker has looked in the bucket and
 * found the object (see MediaProcessor). `FAILED` is the answer when it is not
 * there after every retry, and it is kept rather than deleted so the player is
 * told what happened instead of watching their upload silently vanish.
 */
enum MediaStatus {
  PROCESSING
  ACTIVE
  FAILED
  FLAGGED
  REMOVED
}

/**
 * Whether a human has looked at this clip yet.
 * ## Why this is not folded into `MediaStatus`
 * The two columns answer different questions and a clip needs both answered at
 * once. `MediaStatus` says whether the bytes are really in the bucket — it is
 * the worker's verdict on an upload the API never saw. This says whether anyone
 * is allowed to look at them. A clip is routinely PROCESSING *and* UNVERIFIED,
 * and collapsing the pair into one column would have to lose one of those
 * facts: either "did the upload arrive" or "has a moderator seen it".
 * ## UNVERIFIED is the default, and nothing may write it any other way
 * Uploads are minutes of video of children, and the platform cannot know what is
 * in one until someone watches it. So a clip is private to its uploader from the
 * moment the row is written, and only an admin's explicit act makes it public —
 * never the worker, never the uploader, never a default. The whole moderation
 * system is that one sentence; everything else here enforces it.
 * BLOCKED is the end of the line for a clip and it is *not* a delete: the row,
 * the rating history and the engagement stay, because "what did we take down and
 * when" is the question a moderation decision has to be able to answer later.
 * Only a super admin can actually destroy a clip (AdminController.deleteMedia).
 * `BLOCKED` rather than the spec's `block`: every status enum in this schema is
 * a state in the past participle (ACTIVE, REMOVED, FLAGGED), and a verb reads as
 * something you do rather than something a row *is*.
 */
enum MediaModerationStatus {
  UNVERIFIED
  VERIFIED
  BLOCKED
}

model Media {
  id       String        @id @default(uuid())
  playerId String
  player   PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  type     MediaType
  category MediaCategory

  /// R2 object key under `private/players/<playerId>/`. There is deliberately no
  /// `url` column: a clip of a child must never have a permanent public address,
  /// and a column holding one is an address nobody can revoke. Playback goes
  /// through `GET /media/:id/url`, which authorizes first and then signs a URL
  /// that expires in minutes.
  storageKey String

  /// Object key of a still frame, captured in the browser at upload time.
  ///
  /// The grid shows covers, not players: loading a dozen videos to render a dozen
  /// first frames would cost a player on mobile data more than the rest of the app
  /// (§14). Private like the video it came from — a frame of a child's clip is the
  /// same content, so it is signed at read time and never public.
  ///
  /// Nullable: capture can fail (an unseekable file, a codec the browser will not
  /// decode) and a clip without a cover is far better than a refused upload.
  posterKey String?

  /**
   * Starts at PROCESSING, not ACTIVE — see the enum. Only the media worker
   * promotes a clip, and only after finding its object in the bucket.
   */
  status MediaStatus @default(PROCESSING)

  /**
   * Starts at UNVERIFIED, and only an admin moves it — see the enum.
   * Public visibility is `status = ACTIVE AND moderationStatus = VERIFIED`, and
   * that pair is expressed once in `media-visibility.util.ts` rather than spelled
   * out per query: a visibility rule copied into eleven `where` clauses is a rule
   * that holds in ten of them.
   */
  moderationStatus MediaModerationStatus @default(UNVERIFIED)

  /// Bytes, as the bucket reports them. Recorded by the worker, so it is
  /// evidence the object exists rather than a number the uploader supplied.
  sizeBytes Int?

  /**
   * Why processing gave up, in words a player can act on.
   * Null unless `status` is FAILED. Kept on the row rather than only in the
   * job's log because the person who needs it is the uploader, and they cannot
   * read a queue.
   */
  failureReason String?

  /// When the worker last answered about this clip, whichever way it went.
  processedAt DateTime?

  /**
   * How many times processing has been *restarted* for this clip — by the
   * stale-processing sweep or by an admin — not how many attempts one job made
   * (BullMQ counts those, and forgets them when the job is purged).
   *
   * Kept on the row because it is the bound on the sweep: a clip whose job has
   * died can be re-queued only this many times before it is marked FAILED, and
   * that count has to survive both a worker restart and Redis being flushed.
   */
  processingAttempts Int @default(0)

  title       String?
  description String?

  /// The 0–100 rating for `category` that this clip evidences.
  ///
  /// Null for MATCH_HIGHLIGHTS, which evidences no single attribute. The newest
  /// ACTIVE clip per category carries the current rating; older rows are kept so
  /// the bar has a history rather than just a value.
  ///
  /// The range is a database CHECK (`media_rating_range`) and not only a DTO
  /// rule: the bars are drawn as a percentage of 100, so a value outside it does
  /// not render wrongly — it renders as a bar longer than its track, on every
  /// screen that reads the row, forever.
  rating Int?

  /// Who put `rating` there.
  ///
  /// A player's number is a claim; a coach watching the same clip can replace it,
  /// and then it is evidence (§1.6). One column rather than two nullable ones
  /// because a clip has exactly one current rating — storing both invites a UI
  /// that shows a stale claim beside the coach's correction and leaves the reader
  /// to guess which is live.
  ///
  /// The previous value is not overwritten silently: `RatingRevision` keeps what
  /// it was, who changed it and when.
  reportedBy RatingSource @default(SELF)

  revisions RatingRevision[]

  likes    MediaLike[]
  views    MediaView[]
  comments MediaComment[]
  reports  Report[]       @relation("ReportedMedia")

  createdAt DateTime @default(now())

  @@index([playerId, category, createdAt(sort: Desc)])
  /// The moderation queue, newest first, and the public-visibility filter every
  /// other read now carries. Both are `(moderationStatus, status)` lookups.
  @@index([moderationStatus, status, createdAt(sort: Desc)])
}

model MediaLike {
  id      String @id @default(uuid())
  mediaId String
  userId  String
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([mediaId, userId])
}

/**
 * View counter rows (1.14 `media_views`). `userId` is null for guests, who may view
 * public media (1.2). Deliberately NOT unique per (media, user): a view is an event,
 * not a state, unlike a like.
 */
/**
 * One clip, watched by one viewer, on one day.
 * ## The uniqueness is the deduplication
 * A view used to be deduplicated by a Redis key with a day's TTL. That worked
 * until Redis did not: a `SET NX` that cannot be reached returns "not fresh", so
 * an outage silently stopped counting views altogether — and had it failed the
 * other way it would have counted every request instead. Neither is a property
 * you want a counter to have.
 * The constraint below is the same rule expressed where the rows live, so it
 * holds whatever else is down, and a duplicate is refused by the database rather
 * than by a cache that has to be asked first.
 * `viewerKey` and not `userId` because a unique index treats NULLs as distinct —
 * with a nullable column every anonymous view would be unique and the constraint
 * would do nothing for exactly the traffic it most needs to bound. It carries the
 * account id when there is one and `ip:<address>` when there is not.
 */
model MediaView {
  id      String  @id @default(uuid())
  mediaId String
  userId  String?
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  /// Account id, or `ip:<address>` for a guest. Never null — see the note above.
  viewerKey String
  /// Midnight UTC of the day this was watched. A day everywhere, not per zone:
  /// two viewers in different zones should not get different dedupe windows for
  /// the same clip.
  viewDate  DateTime @db.Date

  createdAt DateTime @default(now())

  @@unique([mediaId, viewerKey, viewDate])
  @@index([mediaId])
}

model MediaComment {
  id      String @id @default(uuid())
  mediaId String
  userId  String
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  body   String
  status MediaStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mediaId])
}

// ---------- FOLLOWS (1.2 / 1.5.2) ----------

enum FollowTargetType {
  PLAYER
  ACADEMY
}

/**
 * Scout -> player / academy following (1.2 Scout permissions).
 */
model Follow {
  id         String @id @default(uuid())
  followerId String
  follower   User   @relation("UserFollows", fields: [followerId], references: [id], onDelete: Cascade)

  targetType FollowTargetType
  targetId   String

  createdAt DateTime @default(now())

  @@unique([followerId, targetType, targetId])
  @@index([targetType, targetId])
}

enum AcademyScoutFollowState {
  FOLLOWING
  MUTED
}

/**
 * Who an academy can take on: a scout, or a coach.
 */
enum EndorsementRole {
  SCOUT
  COACH
}

enum EndorsementStatus {
  ACTIVE
  REVOKED
}

/**
 * An academy has endorsed (hired / accredited) a scout or coach - README 1.5.3.
 * This is the ONLY academy→person relationship with functional consequences, and
 * the distinction from `AcademyScoutFollow` is the point: following is social and
 * changes nothing, the way following someone on Instagram doesn't give them a job.
 * Endorsement does two things:
 * 1. It is the gate for SPECIFIC recommendations — a scout may only address a
 * recommendation to an academy that has endorsed them.
 * 2. It is what earns a specific recommendation its extra weight for that
 * academy, because the academy has already staked its own judgement on the
 * person making it.
 * Revoked rather than deleted: an academy that drops a scout should not silently
 * rewrite the history of recommendations that scout already made for them.
 */
model AcademyEndorsement {
  id        String            @id @default(uuid())
  academyId String
  userId    String
  role      EndorsementRole
  status    EndorsementStatus @default(ACTIVE)

  academy AcademyProfile @relation(fields: [academyId], references: [id], onDelete: Cascade)
  user    User           @relation("AcademyEndorsements", fields: [userId], references: [id], onDelete: Cascade)

  note      String?
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  updatedAt DateTime  @updatedAt

  @@unique([academyId, userId, role])
  @@index([userId, status])
}

/**
 * A player's discoverability weight, accumulated from every recommendation.
 * Stored rather than computed on read because it is written by the same
 * transaction that files or settles a recommendation, and read by search and the
 * feed on every request — a sum recomputed per read would join four tables to
 * answer a question that changes a few times a month.
 * There is no `lastDecayedAt` and no scheduled decay. Weight moves when somebody
 * *answers* a recommendation — an academy, or a coach at a trial — and at no
 * other time. `lastRecommendedAt` is kept because the feed's freshness term
 * reads it, not as a job's bookmark.
 */
model PlayerRecommendationWeight {
  playerId String        @id
  player   PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  globalWeight        Float     @default(0)
  recommendationCount Int       @default(0)
  lastRecommendedAt   DateTime?
  updatedAt           DateTime  @updatedAt

  @@index([globalWeight])
}

/**
 * The extra weight one academy sees for one player, from SPECIFIC recommendations
 * addressed to them. Never leaves that academy: it is their own scouts' opinion of
 * a player, not a public score (README 21.5 — no public ranking of minors).
 */
model PlayerAcademyRecommendationWeight {
  playerId  String
  academyId String
  player    PlayerProfile  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  academy   AcademyProfile @relation(fields: [academyId], references: [id], onDelete: Cascade)

  extraWeight         Float    @default(0)
  recommendationCount Int      @default(0)
  updatedAt           DateTime @updatedAt

  @@id([playerId, academyId])
  @@index([academyId, extraWeight])
}

/**
 * Academy -> scout trust (README 1.5.2). Separate from `Follow` because the
 * follower is an *academy*, not a user, and because MUTED has no meaning in the
 * scout->player direction. Affects that academy's own recommendation ranking only -
 * never the scout's global reputation (1.5).
 */
model AcademyScoutFollow {
  id        String @id @default(uuid())
  academyId String
  scoutId   String

  academy AcademyProfile @relation(fields: [academyId], references: [id], onDelete: Cascade)
  scout   User           @relation("AcademyScoutFollows", fields: [scoutId], references: [id], onDelete: Cascade)

  state AcademyScoutFollowState @default(FOLLOWING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([academyId, scoutId])
  @@index([scoutId])
}

// ---------- SCOUT REPUTATION (1.5) ----------

model ScoutStats {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  totalRecommendations    Int      @default(0)
  acceptedRecommendations Int      @default(0)
  successRate             Float    @default(0)
  level                   Int      @default(1) // 1..6, see RecommendationsService.computeScoutLevel
  weight                  Int      @default(1)
  updatedAt               DateTime @updatedAt
}

// ---------- RECOMMENDATIONS (1.8) ----------

/**
 * A coach's verdict on a player an academy is considering.
 * The academy manager does not judge football — that is what they employ coaches
 * for (§1.9). A recommendation therefore goes out for review before anyone is
 * invited, and the coach answers ACCEPT or REJECT.
 * That is the whole answer. No attribute ratings are written here (TRIAL.md
 * Rule 22): the coach has watched clips, which is enough to say "worth a look"
 * and not enough to score somebody. Scoring belongs to CoachAssessment, gated on
 * the coach and the player sharing a squad group.
 */
model RecommendationReview {
  id                 String  @id @default(uuid())
  /// The scout recommendation that prompted this, if one did.
  ///
  /// Nullable because an academy does not need permission to look at a player: a
  /// manager who spots someone in search can send them straight to a coach. A
  /// recommendation is how a scout puts a player *in front of* an academy, not
  /// the only way one may be considered — tying review to it made scouts a gate
  /// on the academy's own judgement.
  recommendationId   String?
  /**
   * The trial application that prompted this, if one did.
   * The other half of the same idea as `recommendationId`: a coach's job here is
   * "look at this player and say yes or no", and what put the player in front of
   * them — a scout, a trial, or the manager's own eye — is context rather than a
   * different kind of work. Both are nullable and both may be set: a scout's pick
   * who then applies to the trial is one review, not two.
   */
  trialApplicationId String? @unique
  /// Who is being reviewed. Always present, unlike the recommendation.
  playerId           String
  academyId          String
  /**
   * Who answered — or, before anybody has, the first coach it was handed to.
   * The full list is `assignees`. This column is the one that ends up meaning
   * "who made this call", which is what an assessment has to be attributable to
   * and what every downstream read of a decided review wants.
   */
  coachUserId        String
  coachProfileId     String

  /// How this review began — see `ReviewSource`. Defaulted, so every review
  /// written before coach discovery existed reads as what it was.
  source ReviewSource @default(MANAGER_SUBMITTED)

  status ReviewStatus @default(PENDING)
  note   String?

  recommendation   Recommendation?   @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  trialApplication TrialApplication? @relation(fields: [trialApplicationId], references: [id], onDelete: SetNull)
  player           PlayerProfile     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  academy          AcademyProfile    @relation(fields: [academyId], references: [id], onDelete: Cascade)
  coachUser        User              @relation("CoachReviews", fields: [coachUserId], references: [id], onDelete: Cascade)

  /// Every coach who may answer this. See ReviewCoach.
  assignees ReviewCoach[]

  assignedAt DateTime  @default(now())
  decidedAt  DateTime?

  /// One live review per player per academy — two *decisions* about the same
  /// player for the same academy is a contradiction, not a second opinion. Keyed
  /// on the player rather than the recommendation, since there may not be one.
  @@unique([playerId, academyId])
  @@index([coachUserId, status])
}

/**
 * A recommendation whose fate this trial decides.
 * A player rarely arrives on one scout's word. One may have filed a GLOBAL
 * recommendation months ago and another a SPECIFIC one to this academy last
 * week; both were saying the same thing — *look at this player* — and the trial
 * answers both of them at once. So every backing scout gains when the player
 * signs, and every backing scout is turned down together when a coach says no.
 * Snapshotted when the application is created rather than looked up at the end:
 * a scout who files after the trial was arranged did not help arrange it, and
 * counting them would make the success rate reward timing over judgement.
 */
model TrialApplicationBacking {
  applicationId    String
  recommendationId String

  application    TrialApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  recommendation Recommendation   @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([applicationId, recommendationId])
  @@index([recommendationId])
}

/**
 * A coach who may answer a review.
 * A trial is worked by a staff, not by one person, and the profile should be in
 * front of everybody who will be on the pitch that morning. They share one
 * question, so the first to answer settles it — a second opinion recorded as a
 * second decision would leave the academy holding two contradictory answers with
 * no rule for which one counts.
 */
model ReviewCoach {
  reviewId       String
  coachUserId    String
  coachProfileId String

  review    RecommendationReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  coachUser User                 @relation("ReviewAssignments", fields: [coachUserId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([reviewId, coachUserId])
  @@index([coachUserId])
}

/**
 * Who put this player in front of the coach.
 * The review itself is the same object and the same decision either way — this
 * only records how it started, because the manager reading the result wants a
 * different sentence for each: "the coach you sent this player to approved
 * them" against "a coach put this player forward". It is **not** a second state
 * machine; nothing branches on it but the wording.
 */
enum ReviewSource {
  /// A manager sent the player for review (`assignReview`), or a trial did.
  MANAGER_SUBMITTED
  /// A coach found the player themselves and approved them from their profile.
  COACH_DISCOVERED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RecommendationStatus {
  PENDING
  REVIEWING
  ACCEPTED
  REJECTED
}

/**
 * GLOBAL  - "this player is worth looking at", addressed to nobody. Any scout may
 * file one. It raises the player's discoverability weight and has no
 * accept/reject lifecycle, so it never counts toward success_rate.
 * SPECIFIC- addressed to one or more academies that have ENDORSED this scout
 * (README 1.5.3). Each target academy decides independently, and those
 * decisions are what move the scout's reputation.
 */
enum RecommendationType {
  GLOBAL
  SPECIFIC
}

model Recommendation {
  id       String             @id @default(uuid())
  scoutId  String
  playerId String
  type     RecommendationType @default(SPECIFIC)

  /**
   * Legacy single-academy column, kept for rows created before targets existed and
   * for the common one-academy case. GLOBAL recommendations leave it null; the
   * authoritative target list is `targets`.
   */
  academyId String?
  status    RecommendationStatus @default(PENDING)
  note      String?

  /**
   * The scout's §1.5 weight at the moment of filing, not a live lookup.
   * A recommendation is evidence about a point in time. The scout's weight moves
   * every time one of their recommendations is answered (§1.5), so a live lookup
   * would mean a single acceptance silently reweighting every player they have
   * ever put forward — including ones already settled.
   */
  scoutWeight Int @default(1)

  scout             User                      @relation("ScoutRecommendations", fields: [scoutId], references: [id])
  player            PlayerProfile             @relation(fields: [playerId], references: [id])
  academy           AcademyProfile?           @relation(fields: [academyId], references: [id])
  targets           RecommendationTarget[]
  reviews           RecommendationReview[]
  trialApplications TrialApplication[]
  trialBackings     TrialApplicationBacking[]

  /**
   * When a coach turned this recommendation down.
   * Stored rather than derived from `updatedAt`, which moves for reasons that
   * have nothing to do with the answer. It is what the scout's cooldown counts
   * from: a rejection is a judgement about *this* recommendation, and filing the
   * same player again the next morning would be arguing with it rather than
   * bringing new evidence.
   */
  rejectedAt DateTime?

  /**
   * When a trial PASS retired this from the player's live recommendations.
   * TRIAL.md §27 says a pass empties `Player.recommendations`. It cannot mean
   * *delete*, because the very next step in §8 is recalculating the success rate
   * of the scouts who filed them — a number computed from these rows. What is
   * cleared is the player's live backing: they have been placed, so nobody is
   * still vouching for them to be looked at, and the discoverability weight those
   * recommendations bought goes with them.
   * The row survives as the scout's record, which is what the reputation system
   * reads and what the scout sees under "everything I put forward".
   */
  clearedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([playerId])
  @@index([scoutId])
}

/**
 * One target academy of a SPECIFIC recommendation, with its own decision.
 * Separate status per academy because two academies can legitimately disagree
 * about the same player, and the scout's success rate has to reflect each verdict
 * rather than collapsing them into one.
 */
model RecommendationTarget {
  recommendationId String
  academyId        String
  status           RecommendationStatus @default(PENDING)

  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  academy        AcademyProfile @relation(fields: [academyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([recommendationId, academyId])
  @@index([academyId, status])
}

// ---------- COACH ASSESSMENT (1.9) ----------

/**
 * A coach's ratings of a player they coach.
 * Written **if and only if** the coach and the player share an AcademyGroup —
 * TRIAL.md Rule 21, README §1.9, enforced by `GroupsService.assertCoachesPlayer`.
 * The reserve (`AcademyMember.groupId = null`) is the absence of a group, so it
 * qualifies nobody.
 * This is the one number a player cannot write about themselves (§12.4), and it
 * is worth that only if whoever wrote it has watched them train. So it is
 * deliberately unreachable from the two screens where a coach judges a stranger:
 * an online review answers ACCEPT/REJECT and a trial answers PASS/FAIL, and
 * neither writes a row here (Rule 22).
 */
model CoachAssessment {
  id             String @id @default(uuid())
  coachUserId    String
  coachProfileId String
  playerId       String

  coachUser    User          @relation("CoachAssessments", fields: [coachUserId], references: [id])
  coachProfile CoachProfile  @relation("CoachProfileAssessments", fields: [coachProfileId], references: [id])
  player       PlayerProfile @relation(fields: [playerId], references: [id])

  speed      Int
  passing    Int
  vision     Int
  dribbling  Int
  finishing  Int
  physical   Int
  leadership Int
  discipline Int

  notes        String?
  mediaUrls    String[]
  documentUrls String[]

  createdAt DateTime @default(now())
}

// ---------- TRIALS (1.11) ----------

model Trial {
  id        String         @id @default(uuid())
  academyId String
  academy   AcademyProfile @relation(fields: [academyId], references: [id], onDelete: Cascade)

  title       String
  /**
   * Who a trial is open to. Null on a private trial, which is open to nobody.
   * A range answers "may I apply?", and on a private trial nobody may: it exists
   * for one named child who was already chosen. Storing their exact age there
   * was a number that looked like a rule and was really a fact about one person
   * — and it was shown to them as a restriction they had passed.
   */
  ageRangeMin Int?
  ageRangeMax Int?
  /// Wanted positions. Empty on a private trial, for the same reason.
  positions   String[]
  location    String
  /**
   * When the trial window opens — the first day a player can be tested.
   * **Nullable since open-ended trials.** An academy that runs continuous
   * selection has no date to give, and requiring one made them invent a fake
   * one. Null means exactly that: the trial runs until the academy closes it.
   * Still the *only* column existing trials use, and they are unchanged by the
   * move: every trial written before this held a single exam datetime here, and
   * a row with `date` set and `endDate` null still means precisely that. The
   * nullability is new capability, not a new meaning for old rows.
   * Two things read it and must cope with null (see `TrialsService`): age
   * eligibility, which falls back to judging age on the application day, and the
   * upcoming-trials filter, which treats a dateless trial as always upcoming.
   */
  date        DateTime?
  /**
   * When the trial window closes. Null on a single-day trial and on an
   * open-ended one — so null is "no end given", never "ends immediately".
   * Separate from `applyDeadline`, which is about the *list* rather than the
   * sessions: applications can close a week before a window that runs a
   * fortnight.
   */
  endDate     DateTime?
  /**
   * The daily window, as wall-clock `HH:mm` — `"09:00"` to `"18:00"`.
   * Strings rather than DateTimes on purpose. "Nine in the morning, every day of
   * the trial" is a wall-clock fact about a place, not an instant: stored as a
   * timestamp it would need a date to attach to (which day's 09:00?) and would
   * shift for anybody reading it in another zone, so a trial that runs 09:00–18:00
   * in Tashkent would display as 04:00–13:00 to a scout abroad. The rest of the
   * schema stores instants because they *are* instants; these are not.
   */
  startTime   String?
  endTime     String?
  /**
   * Who the trial is open to: `"male"`, `"female"` or `"general"`.
   * A plain string with a default rather than a Prisma enum, because that is how
   * gender is already stored on `PlayerProfile` and two representations of one
   * concept is the thing worth avoiding. The values are validated at the edge
   * (`CreateTrialDto`) and match the client's existing
   * `z.enum(['male', 'female'])`. `general` is a third value that exists only
   * on a trial — a trial can be open to everybody, where a player's own gender
   * is a fact about one person. No migration: the column is already a defaulted
   * string, so a new permitted value is a validation change, not a schema one.
   * Defaulted rather than nullable so every existing trial gets an answer at
   * migration time instead of a null every reader has to interpret.
   */
  gender      String    @default("male")
  /**
   * R2 object key for the cover image, never a URL — see storage.keys.ts.
   * Optional: a trial without a picture is the ordinary case. Lives under the
   * academy's own media prefix, so it is minted by the same server-side helper
   * as the gallery and cannot be pointed at another academy's directory.
   */
  coverKey    String?

  /// Search terms an operator wants this trial found by.
  ///
  /// Never rendered as page content — see `lib/seo.ts` on the client. They feed
  /// the metadata a crawler reads, alongside the real title, description and
  /// canonical, and they supplement that content rather than replacing it.
  ///
  /// A Postgres text array rather than a join table, matching `Trial.positions`:
  /// the values are short, unordered, never queried individually and only ever
  /// read as a whole with the row they belong to.
  ///
  /// Defaulted to empty so every existing row has an answer at migration time
  /// rather than a null every reader would have to interpret. Normalised on the
  /// way in — trimmed, de-duplicated case-insensitively, capped — by
  /// `seo-keywords.util.ts`, so the column cannot accumulate near-duplicates.
  seoKeywords String[] @default([])

  /**
   * Last moment a player may put themselves forward.
   * Separate from `date` because an academy needs the list closed before the
   * morning it runs: somebody has to book pitches, print sheets and tell coaches
   * how many are coming. Applications after that point are not late, they are
   * impossible.
   * Nullable only for trials created before deadlines existed — those stay open
   * until their exam date, which is how they already behaved. Every new trial
   * carries one.
   */
  applyDeadline DateTime?
  requirements  String?
  /**
   * What the academy wants the player to read, as sanitised HTML.
   * Rich rather than plain because this is where an academy writes the things a
   * family actually needs — what to bring, where to park, who to ask for — and
   * those read as a list, not a paragraph. Stored already sanitised: it arrives
   * through `sanitizeRichText`, so nothing downstream has to remember to clean
   * it, and a row that somehow held a script tag could not have come from this
   * API.
   * Prefilled from `AcademyProfile.defaultTrialNote` at the screen, not here —
   * a default is a starting point for the person writing, not a value the
   * database should invent.
   */
  note          String?

  /// Archived trials keep their applicants and stop taking new ones.
  status TrialStatus @default(OPEN)
  /// GENERAL is public and self-serve; PRIVATE is by invitation only.
  type   TrialType   @default(GENERAL)

  applications TrialApplication[]
  /// The coaches who screen and assess for this trial. A private trial is
  /// visible to them; a general one hands them its applicants automatically.
  coaches      TrialCoach[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

/**
 * A trial is never deleted, only closed.
 * Every application attached to it is a decision somebody made about a child,
 * and a row that vanishes takes that record with it. Archiving hides the trial
 * from the public list and refuses new applications; the academy keeps the
 * history, and can reopen it if it was closed by mistake.
 */
enum TrialStatus {
  OPEN
  ARCHIVED
}

/**
 * Who a trial is for.
 * GENERAL is the open day: any player may find it and apply, and screening
 * happens after they do. PRIVATE is the opposite motion — the academy (or a
 * scout, through a recommendation) picks somebody, has a coach screen them, and
 * only then invites them. It is never listed publicly, because a session for one
 * named child is not an announcement.
 */
enum TrialType {
  GENERAL
  PRIVATE
}

/**
 * A coach working a trial.
 * Assignment is per trial rather than per academy: a club runs its U14 morning
 * and its goalkeeper session with different staff, and "every endorsed coach can
 * see every trial" makes the private ones public within the building.
 */
model TrialCoach {
  trialId     String
  coachUserId String

  trial     Trial @relation(fields: [trialId], references: [id], onDelete: Cascade)
  coachUser User  @relation("TrialCoaching", fields: [coachUserId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([trialId, coachUserId])
  @@index([coachUserId])
}

/**
 * Where an application stands, in the order it moves.
 * Two routes end at the same place, and only one of them is screened online
 * (TRIAL.md Rule 5):
 * general  APPLIED ─────────────────────────────→ PASSED / FAILED
 * private  SCREENING → SHORTLISTED → INVITED → CONFIRMED → PASSED / FAILED
 * `APPLIED`      a player put themselves forward (general trials only)
 * `SCREENING`    a coach has the profile — the online review is running
 * `SHORTLISTED`  the online review said ACCEPT; the academy's move is next
 * `INVITED`      a private trial's invitation is out, awaiting the player
 * `CONFIRMED`    the player accepted and is expected on the day
 * `PASSED`       a coach tested them in person and passed them (see TrialResult)
 * `FAILED`       a coach tested them in person and failed them
 * `ACCEPTED`     the academy took them on — squad placement, after a PASS
 * `REJECTED`     the online review said REJECT, the academy said no, or the
 * player declined the invitation
 * `PASSED`/`FAILED` are the *coach's* verdict and `ACCEPTED` is the *academy's*
 * administrative act on top of it. They are deliberately different words: §36
 * forbids reading a trial verdict as an accept/reject, and conflating the two is
 * what let an online approval unlock a squad place.
 */
enum TrialApplicationStatus {
  APPLIED
  SCREENING
  SHORTLISTED
  INVITED
  CONFIRMED
  PASSED
  FAILED
  REJECTED
  ACCEPTED
}

model TrialApplication {
  id       String                 @id @default(uuid())
  trialId  String
  playerId String
  status   TrialApplicationStatus @default(APPLIED)

  /// What the academy wrote when inviting — where to be, when, what to bring.
  /// "You are invited" with nothing else is not something a family can act on.
  inviteNote       String?
  /**
   * The recommendation that prompted this invitation, if one did.
   * The *whole* set of scouts whose reputation rides on the outcome is
   * `backings` — this is only the one the manager was looking at when they
   * decided to invite.
   */
  recommendationId String?
  recommendation   Recommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)

  /// Every scout whose call this trial will settle. See TrialApplicationBacking.
  backings TrialApplicationBacking[]
  /**
   * The *online* coach review that screened this application, if one ran.
   * Private trials only. A general trial is not screened online at all
   * (TRIAL.md Rule 5) — the player applies and is tested on the day.
   */
  review   RecommendationReview?
  /// What the coach said after testing them in person. See TrialResult.
  result   TrialResult?

  trial  Trial         @relation(fields: [trialId], references: [id], onDelete: Cascade)
  player PlayerProfile @relation(fields: [playerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([trialId, playerId])
}

/**
 * PASS or FAIL — TRIAL.md Rule 4.
 * Never ACCEPT/REJECT. Those belong to the online review, which decides whether
 * a player is worth *looking at*; this decides whether they passed the football
 * examination, and only this one reaches a squad (Rule 8).
 */
enum TrialVerdict {
  PASS
  FAIL
}

/**
 * A coach's verdict after physically testing a player at a trial.
 * Its own row rather than a second decision on `RecommendationReview`, which is
 * what this used to be. Rule 19 forbids merging the two, and the merged version
 * had a concrete cost: reopening the review reset the online screening to
 * PENDING, so "what did the coach say about this player's profile" and "did they
 * pass the day" overwrote each other, and there was no way to hold both.
 * One per application. A trial answers once — a second look is a second trial,
 * with its own application and its own row.
 */
model TrialResult {
  id            String           @id @default(uuid())
  applicationId String           @unique
  application   TrialApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  /// The coach who ran the test. Must be working this trial — see TrialCoach.
  coachUserId    String
  coachProfileId String
  coachUser      User   @relation("TrialVerdicts", fields: [coachUserId], references: [id], onDelete: Cascade)

  verdict TrialVerdict
  note    String?

  decidedAt DateTime @default(now())

  @@index([coachUserId])
}

// ---------- NOTIFICATIONS (1.12) ----------

enum NotificationEvent {
  /// A coach has been handed a player to review.
  REVIEW_ASSIGNED
  /**
   * A coach accepted a player at online review, and the academy's move is next.
   * Only an ACCEPT is sent. A rejection asks nothing of the manager — the coach
   * has answered and the line is closed — whereas an acceptance leaves a player
   * waiting on an invitation only they can send.
   */
  REVIEW_DECIDED
  /// An academy is inviting the player, with the manager's note.
  ACADEMY_INVITATION
  /// An academy is asking somebody to join it — awaiting their yes or no.
  ACADEMY_JOIN_INVITATION
  /// How the person answered an academy's invitation to join.
  ACADEMY_JOIN_ANSWER
  RECOMMENDATION_ACCEPTED
  RECOMMENDATION_REJECTED
  TRIAL_INVITATION
  /**
   * A new open trial matches this player's position and age.
   * Sent on creation to players the trial is actually for, never to everybody:
   * a notification that does not apply to you teaches you to ignore the ones
   * that do. Matching is on the same two fields the academy filled in — the
   * wanted positions and the age range — so the message is true by construction
   * rather than by a ranking somebody has to trust.
   */
  TRIAL_PUBLISHED
  /**
   * The exam moved. Sent to everybody already holding an application.
   * A date is the one detail of a trial a family has arranged their week around,
   * so changing it silently is the one edit that can waste somebody's morning.
   */
  TRIAL_RESCHEDULED
  TRIAL_RESULT
  /**
   * The academy has taken the player on after a trial they passed.
   * Separate from the join invitation the placement also sends: that one is
   * paperwork awaiting a yes, this one is the news. A child who passed a trial
   * should be told they passed and were wanted, not only handed a form.
   */
  SQUAD_PLACEMENT
  /**
   * Somebody joined a squad this manager runs.
   * Separate from ACADEMY_JOIN_ANSWER, which is the answer to *one* invitation
   * and is sent to whoever asked. This is the squad changing, and it is sent
   * however the change happened — an invitation accepted, a transfer imported —
   * so a manager who did not send the invitation still learns their squad grew.
   */
  SQUAD_JOINED
  /**
   * Somebody left a squad this manager runs, and why does not change who needs
   * to know. A player removed by the manager, a player who left a local team of
   * their own accord, and a player who accepted another academy all end here.
   */
  SQUAD_LEFT
  VERIFICATION_RESULT
}

model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /**
   * Who caused this, and in what capacity.
   * "A coach accepted a player" and "the academy accepted a player" are read
   * very differently by whoever gets the message, and until now a notification
   * said neither — only what happened. Nullable for the events nobody triggered:
   * a scheduled job, or a rule firing on its own.
   * `actorRole` is stored rather than derived because a user holds several roles
   * at once and only the caller knows which one was acting. A scout who is also
   * a coach rejecting a player did it as a coach, and the row should say so a
   * year later even if they have stopped being either.
   */
  actorUserId String?
  actor       User?   @relation("NotificationActors", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorRole   String?

  event   NotificationEvent
  payload Json
  read    Boolean           @default(false)

  createdAt DateTime @default(now())
}

// ---------- MODERATION (1.13) ----------

enum ReportType {
  USER
  MEDIA
  ACADEMY
  COACH
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

model Report {
  id     String     @id @default(uuid())
  type   ReportType
  reason String

  reporterId String
  reporter   User   @relation("ReportsFiled", fields: [reporterId], references: [id])

  targetUserId    String?
  targetMediaId   String?
  targetAcademyId String?
  targetCoachId   String?
  targetMedia     Media?  @relation("ReportedMedia", fields: [targetMediaId], references: [id])

  status         ReportStatus @default(PENDING)
  resolutionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- AUDIT (1.21) ----------

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  meta      Json?
  createdAt DateTime @default(now())
}

/// What a user asked the team to do — the front door for anything the app has no
/// button for.
///
/// Account deletion is the reason this exists. The privacy policy promises an
/// account can be removed, and self-service erasure of a minor's profile is not
/// a button worth building: it is irreversible, it is exactly what a hijacked
/// session would press, and the person asking often wants something narrower
/// (take my clips down, hide me from search) that a conversation finds and a
/// button cannot.
enum SupportRequestType {
  DELETE_ACCOUNT
  FEEDBACK
  BUG
  OTHER
}

/// NEW is what the admin badge counts. A request leaves that state only when
/// somebody has actually picked it up, so the number on the navbar is a queue
/// depth rather than a notification anybody can dismiss.
enum SupportRequestStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  DECLINED
}

/// A request from a user to the people who run the platform.
model SupportRequest {
  id     String @id @default(uuid())
  userId String
  user   User   @relation("RequestsMade", fields: [userId], references: [id], onDelete: Cascade)

  type    SupportRequestType
  status  SupportRequestStatus @default(NEW)
  /// What the user said in their own words. Optional: "delete my account" needs
  /// no explanation, and demanding one would be a hurdle in front of a right.
  message String?

  /// Who picked it up, what they did, and when. Kept after the fact so a later
  /// question about an account has an answer that is not somebody's memory.
  handledById String?
  handledBy   User?     @relation("RequestsHandled", fields: [handledById], references: [id], onDelete: SetNull)
  handledNote String?
  handledAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
}
