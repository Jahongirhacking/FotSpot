DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fotspot"
# Used by RedisService (README 1.19). The API degrades to Postgres-only reads if
# Redis is unreachable, so this is not required to boot.
#
# BullMQ uses the same server on its own connection (see app.module.ts). Uploads
# are finalised by a worker on that queue, so with Redis down clips stay
# PROCESSING until it returns — they are not lost, only not yet visible.
REDIS_URL="redis://localhost:6379"

# The API refuses to start in production while either of these is missing, still
# the example value, under 32 characters, or equal to the other — see
# src/common/security.config.ts. Generate each with:
#   openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-access"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_REFRESH_TTL="30d"

# Browser origins allowed to call this API, comma-separated. Empty in
# development reflects whatever asked (so `next dev` on a shifting port works);
# empty in production allows no browser origin at all, because a missing security
# setting must fail closed rather than revert to allow-all.
CORS_ORIGINS=""

# How many proxies actually sit in front of this process — 1 behind a single load
# balancer, 2 behind a CDN and a balancer.
#
# It decides which entry of `X-Forwarded-For` is treated as the real client, and
# both the login lockout and the request throttle key on that address. Leave at 0
# unless something in front genuinely appends the header: trusting it when nothing
# does lets any caller mint a fresh identity per request and walk through both.
TRUST_PROXY_HOPS="0"

OTP_TTL_SECONDS="300"

# Cloudflare R2 (S3-compatible) - plug real values in production
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="fotspot-media"
# Origins allowed to upload straight to R2 (see `pnpm r2:cors`).
# The backend holds port 3000, so `next dev` serves the client on 3001.
R2_CORS_ORIGINS="http://localhost:3001"
# The CDN origin for the **public** tier — avatars and academy imagery only.
#
# Object keys are tiered by prefix inside one bucket: `public/…` is served from
# this host, `private/…` (player clips, and the §12.1 identity documents) is
# reachable only through a signature the API mints per read.
#
# IMPORTANT: scope R2 public read access to the `public/` prefix. If it is
# enabled for the whole bucket, `private/players/…` is fetchable at this host
# regardless of what the code intends — a prefix declares intent, the bucket
# grants permission, and only the second one is enforcement.
R2_PUBLIC_BASE_URL="https://media.fotspot.uz"

PORT=3000
